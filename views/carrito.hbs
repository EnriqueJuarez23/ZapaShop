<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tu Carrito - ZapaShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-slate-950 font-sans antialiased text-slate-100 min-h-screen">

    <!-- Barra de Navegación Responsiva con Menú Hamburguesa Integrado -->
    <nav class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50 text-slate-100">
        <div class="max-w-7xl mx-auto px-4 h-20 flex justify-between items-center">
            <a href="/" class="text-xl md:text-2xl font-black text-blue-500 tracking-tight flex items-center gap-2">
                <div class="bg-blue-600 p-2 rounded-xl text-white">
                    <i data-lucide="shopping-bag" class="w-5 h-5"></i>
                </div>
                <span>ZapaShop</span>
            </a>

            <!-- Enlaces de Escritorio -->
            <div class="hidden md:flex gap-8 font-bold text-sm text-slate-300">
                <a href="/" class="hover:text-blue-400 transition-colors">Inicio</a>
                <a href="/catalogo" class="hover:text-blue-400 transition-colors">Catálogo</a>
                <a href="/carrito" class="text-blue-400 border-b-2 border-blue-400">Carrito</a>
            </div>

            <!-- Acciones Derecha -->
            <div class="flex items-center gap-3">
                <a href="/carrito" class="relative group p-2 text-slate-300 hover:text-white">
                    <i data-lucide="shopping-cart" class="w-6 h-6"></i>
                    <span id="cart-count" class="cart-count absolute -top-1 -right-1 bg-blue-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">0</span>
                </a>
                <button id="btnHamburguesa" class="md:hidden p-2 text-slate-300 hover:text-white focus:outline-none cursor-pointer">
                    <i data-lucide="menu" class="w-7 h-7"></i>
                </button>
            </div>
        </div>

        <!-- Menú Desplegable Móvil -->
        <div id="menuMovilDesplegable" class="hidden md:hidden bg-slate-950 border-t border-slate-800 px-6 py-5 space-y-4 font-bold text-sm text-slate-300 shadow-2xl">
            <a href="/" class="block hover:text-blue-400 py-1 border-b border-slate-900">🏠 Inicio</a>
            <a href="/catalogo" class="block hover:text-blue-400 py-1 border-b border-slate-900">👟 Catálogo</a>
            <a href="/carrito" class="block text-blue-400 py-1 border-b border-slate-900">🛒 Mi Carrito</a>
            <a href="/perfil" class="block hover:text-blue-400 py-1">👤 Mi Perfil / Cuenta</a>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto py-8 md:py-12 px-4">
        <h2 class="text-3xl md:text-4xl font-black text-white mb-8 md:mb-10 flex items-center gap-4">
            <i data-lucide="shopping-cart" class="w-8 h-8 md:w-10 md:h-10 text-blue-500"></i>
            Tu Carrito de Compras
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2 space-y-4">
                <div id="listaCarrito" class="space-y-6">
                    <div class="text-center py-20 bg-slate-900 rounded-3xl border border-slate-800">
                        <i data-lucide="shopping-basket" class="w-16 h-16 text-slate-600 mx-auto mb-4"></i>
                        <p class="text-slate-400 text-lg font-medium">Tu carrito está esperando que elijas algo genial.</p>
                        <a href="/catalogo" class="text-blue-400 font-bold hover:underline mt-3 inline-block">Ir a la tienda &rarr;</a>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-1">
                <div class="bg-slate-900 rounded-[2.5rem] p-6 md:p-8 text-white shadow-2xl border border-slate-800 sticky top-28">
                    <h2 class="text-xl md:text-2xl font-black mb-6 md:mb-8 flex items-center gap-3">
                        <i data-lucide="receipt" class="w-6 h-6 text-blue-400"></i>
                        Resumen
                    </h2>
                    
                    <div class="space-y-4">
                        <div class="flex justify-between text-slate-400 text-sm font-medium">
                            <span>Subtotal</span>
                            <span id="subtotalCarrito" class="text-white font-bold">$0.00</span>
                        </div>
                        <div class="flex justify-between text-slate-400 text-sm font-medium">
                            <span>Envío</span>
                            <span class="text-emerald-400 font-bold uppercase">Gratis</span>
                        </div>
                        
                        <div class="border-t border-slate-800 pt-4 mt-4">
                            <div class="flex justify-between items-end">
                                <span class="text-xs font-black text-slate-500 uppercase tracking-widest">Total a pagar</span>
                                <span id="totalCarrito" class="text-2xl md:text-3xl font-black text-blue-400">$0.00</span>
                            </div>
                        </div>

                        <button onclick="finalizarPedido()" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-black py-4 rounded-2xl transition-all duration-300 uppercase text-xs tracking-widest mt-6 shadow-lg shadow-blue-600/30 cursor-pointer">
                            Confirmar Pedido
                        </button>    
                        <p class="text-[10px] text-center mt-6 text-slate-500 font-medium">
                            🔒 Pago seguro y encriptado
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-slate-900 border-t border-slate-800 text-white py-12 mt-20">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-slate-500 text-xs">© 2026 ZapaShop. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="/app.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            if (typeof actualizarVistaCarrito === 'function') {
                actualizarVistaCarrito();
            }
            if (window.lucide) lucide.createIcons();
        });
    </script>
</body>
</html>
