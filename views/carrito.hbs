<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tu Carrito - ZapaShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="/styles.css">
</head>
<body class="bg-gray-50 font-sans">

    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <a href="/" class="flex items-center gap-2">
                    <i data-lucide="shopping-bag" class="w-8 h-8 text-blue-600"></i>
                    <span class="text-xl font-bold text-gray-900">ZapaShop</span>
                </a>
                <nav class="hidden md:flex items-center gap-6">
                    <a href="/" class="text-gray-700 hover:text-blue-600">Inicio</a>
                    <a href="/carrito" class="text-blue-600 font-bold">Carrito</a>
                    <a href="/perfil" class="text-gray-700 hover:text-blue-600">Mi Perfil</a>
                    <a href="/admin" class="text-red-600 font-bold">Admin</a>
                </nav>
            </div>
        </div>
    </header>

    <main class="max-w-4xl mx-auto py-12 px-4">
        <h2 class="text-4xl font-extrabold text-gray-900 mb-10 flex items-center gap-4">
            <i data-lucide="shopping-cart" class="w-10 h-10 text-blue-600"></i>
            Tu Carrito
        </h2>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2 space-y-4">
                <div id="listaCarrito" class="bg-white rounded-2xl shadow-sm p-6 border border-gray-100">
                    <div class="text-center py-10">
                        <i data-lucide="shopping-basket" class="w-16 h-16 text-gray-200 mx-auto mb-4"></i>
                        <p class="text-gray-500 text-lg">Tu carrito está esperando que elijas algo genial.</p>
                        <a href="/#catalogo" class="text-blue-600 font-medium hover:underline mt-2 inline-block">Ir a la tienda</a>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-1">
                <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100 sticky top-24">
                    <h3 class="text-xl font-bold mb-6">Resumen de compra</h3>
                    <div class="space-y-4 text-gray-600">
                        <div class="flex justify-between">
                            <span>Subtotal</span>
                            <span id="subtotalCarrito">$0.00</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Envío</span>
                            <span class="text-green-600 font-medium">Gratis</span>
                        </div>
                        <div class="border-t pt-4 flex justify-between items-center text-gray-900">
                            <span class="text-lg font-bold">Total</span>
                            <span id="totalCarrito" class="text-2xl font-black text-blue-600">$0.00</span>
                        </div>
                    </div>
                    <button onclick="alert('¡Compra procesada!')" class="w-full mt-8 bg-black text-white py-4 rounded-xl font-bold hover:bg-gray-800 transition-colors shadow-lg">
                        Finalizar Pedido
                    </button>
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-gray-900 text-white py-12 mt-20">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-gray-400">© 2026 ZapaShop. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="/app.js"></script>
    <script>lucide.createIcons();</script>
</body>
</html>
