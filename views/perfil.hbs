<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Perfil - ZapaShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-slate-950 font-sans text-slate-100 min-h-screen">

    <!-- Barra de Navegación Responsiva con Menú Hamburguesa Integrado -->
    <nav class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50 text-slate-100">
        <div class="max-w-7xl mx-auto px-4 h-20 flex justify-between items-center">
            <a href="/" class="text-xl md:text-2xl font-black text-blue-500 tracking-tight flex items-center gap-2">
                <div class="bg-blue-600 p-2 rounded-xl text-white">
                    <i data-lucide="shopping-bag" class="w-5 h-5"></i>
                </div>
                <span>ZapaShop</span>
            </a>

            <!-- Enlaces de Escritorio -->
            <div class="hidden md:flex gap-8 font-bold text-sm text-slate-300">
                <a href="/" class="hover:text-blue-400 transition-colors">Inicio</a>
                <a href="/catalogo" class="hover:text-blue-400 transition-colors">Catálogo</a>
                <a href="/carrito" class="hover:text-blue-400 transition-colors">Carrito</a>
            </div>

            <!-- Acciones Derecha -->
            <div class="flex items-center gap-3">
                <a href="/carrito" class="relative group p-2 text-slate-300 hover:text-white">
                    <i data-lucide="shopping-cart" class="w-6 h-6"></i>
                    <span id="cart-count" class="cart-count absolute -top-1 -right-1 bg-blue-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">0</span>
                </a>
                <button id="btnHamburguesa" class="md:hidden p-2 text-slate-300 hover:text-white focus:outline-none cursor-pointer">
                    <i data-lucide="menu" class="w-7 h-7"></i>
                </button>
            </div>
        </div>

        <!-- Menú Desplegable Móvil -->
        <div id="menuMovilDesplegable" class="hidden md:hidden bg-slate-950 border-t border-slate-800 px-6 py-5 space-y-4 font-bold text-sm text-slate-300 shadow-2xl">
            <a href="/" class="block hover:text-blue-400 py-1 border-b border-slate-900">🏠 Inicio</a>
            <a href="/catalogo" class="block hover:text-blue-400 py-1 border-b border-slate-900">👟 Catálogo</a>
            <a href="/carrito" class="block hover:text-blue-400 py-1 border-b border-slate-900">🛒 Mi Carrito</a>
            <a href="/perfil" class="block text-blue-400 py-1">👤 Mi Perfil / Cuenta</a>
        </div>
    </nav>

    <main class="max-w-4xl mx-auto py-12 px-4">
        
        <!-- SECCIÓN FORMULARIOS (NO LOGUEADO) -->
        <div id="seccionAuth" class="max-w-md mx-auto bg-slate-900 p-8 rounded-[2.5rem] shadow-2xl border border-slate-800">
            <div class="flex bg-slate-950 p-1.5 rounded-2xl mb-8 border border-slate-800">
                <button id="btnTabLogin" class="flex-1 py-3 rounded-xl font-black text-xs transition-all bg-blue-600 text-white shadow-lg cursor-pointer">Entrar</button>
                <button id="btnTabRegistro" class="flex-1 py-3 rounded-xl font-bold text-xs transition-all text-slate-400 hover:text-white cursor-pointer">Registrarme</button>
            </div>

            <!-- Formulario Registro -->
            <form id="formRegistro" class="hidden space-y-4">
                <h2 class="text-2xl font-black text-white mb-2">Crea tu cuenta</h2>
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 tracking-widest">Nombre Completo</label>
                    <input type="text" id="regNombre" required class="w-full p-3.5 bg-slate-950 border border-slate-800 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 text-sm text-white font-medium">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 tracking-widest">Correo Electrónico</label>
                    <input type="email" id="regEmail" required class="w-full p-3.5 bg-slate-950 border border-slate-800 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 text-sm text-white font-medium">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 tracking-widest">Contraseña</label>
                    <input type="password" id="regPass" required class="w-full p-3.5 bg-slate-950 border border-slate-800 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 text-sm text-white font-medium">
                </div>
                <button type="submit" class="w-full bg-blue-600 text-white py-4 rounded-xl font-black hover:bg-blue-500 transition-all shadow-lg shadow-blue-600/30 uppercase text-xs tracking-widest cursor-pointer mt-2">
                    REGISTRARME AHORA
                </button>
            </form>

            <!-- Formulario Login -->
            <form id="formLogin" class="space-y-4">
                <h2 class="text-2xl font-black text-white mb-2">¡Hola de nuevo!</h2>
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 tracking-widest">Usuario o Correo</label>
                    <input type="text" id="loginUser" required class="w-full p-3.5 bg-slate-950 border border-slate-800 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 text-sm text-white font-medium">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1 tracking-widest">Contraseña</label>
                    <input type="password" id="loginPass" required class="w-full p-3.5 bg-slate-950 border border-slate-800 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 text-sm text-white font-medium">
                </div>
                <button type="submit" class="w-full bg-blue-600 text-white py-4 rounded-xl font-black hover:bg-blue-500 transition-all shadow-lg shadow-blue-600/30 uppercase text-xs tracking-widest cursor-pointer mt-2">
                    INICIAR SESIÓN
                </button>
            </form>
        </div>

        <!-- SECCIÓN PERFIL E HISTORIAL (USUARIO LOGUEADO) -->
        <div id="seccionUsuarioLogueado" class="hidden space-y-8">
            <!-- Tarjeta Saludo -->
            <div class="bg-gradient-to-r from-slate-900 to-blue-950 p-8 rounded-[2.5rem] text-white shadow-2xl border border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-6">
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 bg-blue-600 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-blue-600/40">
                        <i data-lucide="user-check" class="w-8 h-8"></i>
                    </div>
                    <div>
                        <h2 class="text-3xl font-black">¡Hola, <span id="nombreUsuarioPerfil"></span>!</h2>
                        <p class="text-slate-400 text-xs mt-1 font-medium">Bienvenido a tu panel de control personal.</p>
                    </div>
                </div>
                <div class="flex gap-3 w-full sm:w-auto">
                    <a href="/admin" id="btnIrAdmin" class="hidden bg-blue-600 hover:bg-blue-500 text-white px-5 py-3 rounded-xl font-bold text-xs transition flex items-center gap-2 cursor-pointer shadow-lg shadow-blue-600/30">
                        <i data-lucide="shield-check" class="w-4 h-4"></i> Admin
                    </a>
                    <button onclick="cerrarSesion()" class="bg-rose-500/20 text-rose-300 hover:bg-rose-600 hover:text-white px-5 py-3 rounded-xl font-bold text-xs transition flex items-center gap-2 cursor-pointer border border-rose-500/30">
                        <i data-lucide="log-out" class="w-4 h-4"></i> Salir
                    </button>
                </div>
            </div>

            <!-- Contenedor Historial de Pedidos -->
            <div class="bg-slate-900 p-8 rounded-[2.5rem] border border-slate-800 shadow-2xl">
                <h3 class="text-xl font-black text-white mb-6 flex items-center gap-3">
                    <i data-lucide="package-check" class="w-6 h-6 text-blue-400"></i>
                    Historial de Compras y Pedidos
                </h3>
                <div id="contenedorHistorialPedidos" class="space-y-4">
                    <!-- Se llena dinámicamente con app.js -->
                </div>
            </div>
        </div>

    </main>

    <footer class="bg-slate-900 border-t border-slate-800 text-white py-12 mt-20">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-slate-500 text-xs">© 2026 ZapaShop. Todos los derechos reservados.</p>
        </div>
    </footer>

    <script src="/app.js"></script>
    <script src="/accesibilidad.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof verificarEstadoSesion === 'function') verificarEstadoSesion();
            if (window.lucide) lucide.createIcons();
        });
    </script>
</body>
</html>
