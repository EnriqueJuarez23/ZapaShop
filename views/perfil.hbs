<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Perfil - ZapaShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gray-50 font-sans">

    <header class="bg-white shadow-sm h-16 flex items-center">
        <div class="max-w-7xl mx-auto px-4 w-full flex justify-between items-center">
            <a href="/" class="text-2xl font-black text-blue-600">ZapaShop</a>
            <nav class="flex gap-6 font-medium text-gray-600">
                <a href="/" class="hover:text-blue-600">Inicio</a>
                <a href="/catalogo" class="hover:text-blue-600">Catálogo</a>
                <a href="/carrito" class="hover:text-blue-600">Carrito</a>
            </nav>
        </div>
    </header>

    <main class="max-w-md mx-auto py-16 px-4">
        <div class="bg-white p-8 rounded-3xl shadow-xl border border-gray-100">
            <div class="flex bg-gray-100 p-1 rounded-xl mb-8">
                <button id="btnTabLogin" onclick="cambiarModo('login')" class="flex-1 py-2 rounded-lg font-bold text-sm transition-all bg-white shadow-sm text-blue-600">Entrar</button>
                <button id="btnTabRegistro" onclick="cambiarModo('registro')" class="flex-1 py-2 rounded-lg font-bold text-sm transition-all text-gray-500">Registrarme</button>
            </div>

            <form id="formRegistro" class="hidden space-y-4">
                <h2 class="text-2xl font-black text-gray-900 mb-2">Crea tu cuenta</h2>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Nombre</label>
                        <input type="text" id="regNombre" required class="w-full p-3 bg-gray-50 border rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Apellidos</label>
                        <input type="text" id="regApellidos" required class="w-full p-3 bg-gray-50 border rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Nombre de Usuario</label>
                    <input type="text" id="regUser" required class="w-full p-3 bg-gray-50 border rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Correo Electrónico</label>
                    <input type="email" id="regEmail" required class="w-full p-3 bg-gray-50 border rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Contraseña</label>
                    <input type="password" id="regPass" required class="w-full p-3 bg-gray-50 border rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <button type="submit" class="w-full bg-blue-600 text-white py-4 rounded-xl font-black hover:bg-blue-700 transition-all shadow-lg shadow-blue-200">
                    REGISTRARME AHORA
                </button>
             </form>

<form id="formLogin" class="space-y-4">
    <h2 class="text-2xl font-black text-gray-900 mb-2">¡Hola de nuevo!</h2>
    <div>
        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Usuario o Correo</label>
        <input type="text" id="loginUser" required class="w-full p-3 bg-gray-50 border rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
    </div>
    <div>
        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Contraseña</label>
        <input type="password" id="loginPass" required class="w-full p-3 bg-gray-50 border rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
    </div>
    <button type="submit" class="w-full bg-gray-900 text-white py-4 rounded-xl font-black hover:bg-black transition-all">
        INICIAR SESIÓN
    </button>
     </form>
<div id="seccionUsuarioLogueado" class="hidden text-center space-y-6">
    <div class="bg-blue-50 p-8 rounded-3xl border border-blue-100">
        <i data-lucide="user-check" class="w-16 h-16 text-blue-600 mx-auto mb-4"></i>
        <h2 class="text-3xl font-black text-gray-900">¡Hola, <span id="nombreUsuarioPerfil"></span>!</h2>
        <p class="text-gray-500">Estás en tu zona segura. Aquí puedes ver tus pedidos y gestionar tu cuenta.</p>
    </div>

    <a href="/admin" id="btnIrAdmin" class="hidden w-full bg-slate-900 text-white py-4 rounded-xl font-black hover:bg-black transition-all flex items-center justify-center gap-2">
        <i data-lucide="shield-check" class="w-5 h-5"></i>
        PANEL DE ADMINISTRADOR
    </a>

    <button onclick="cerrarSesion()" class="w-full bg-red-100 text-red-600 py-4 rounded-xl font-bold hover:bg-red-200 transition-all flex items-center justify-center gap-2">
        <i data-lucide="log-out" class="w-5 h-5"></i>
        CERRAR SESIÓN
    </button>
</div>
 </main>

    <script src="/app.js"></script>
</body>
</html>
