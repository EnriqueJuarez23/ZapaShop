<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZapaShop | Tu Estilo, Tu Paso</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-50 text-slate-900 font-sans">

    <nav class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-slate-100">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <div class="flex items-center gap-2">
                <div class="bg-blue-600 p-2 rounded-xl">
                    <i data-lucide="zap" class="text-white w-6 h-6"></i>
                </div>
                <span class="text-2xl font-black tracking-tighter">ZAPASHOP</span>
            </div>

            <div class="flex items-center gap-6">
                <a href="/perfil" class="flex items-center gap-2 font-bold text-slate-600 hover:text-blue-600 transition-colors">
                    <i data-lucide="user" class="w-5 h-5"></i>
                    <span id="navUsuario">Mi Cuenta</span>
                </a>
                <a href="/carrito" class="relative bg-slate-900 text-white p-3 rounded-full hover:scale-110 transition-transform shadow-lg">
                    <i data-lucide="shopping-cart" class="w-5 h-5"></i>
                    <span id="cartCount" class="absolute -top-1 -right-1 bg-blue-500 text-[10px] font-bold w-5 h-5 flex items-center justify-center rounded-full border-2 border-white">0</span>
                </a>
            </div>
        </div>
    </nav>

    <header class="max-w-7xl mx-auto px-6 pt-10 pb-16">
        <div class="bg-slate-900 rounded-[3rem] p-12 overflow-hidden relative min-h-[400px] flex items-center">
            <div class="relative z-10 max-w-xl">
                <span class="text-blue-400 font-bold tracking-widest uppercase text-sm">Nueva Colección 2026</span>
                <h1 class="text-6xl font-black text-white leading-tight mt-4 mb-6">Camina con el futuro en tus pies.</h1>
                <p class="text-slate-400 text-lg mb-8">Descubre la tecnología y el diseño que están revolucionando el mundo del calzado deportivo.</p>
                <button class="bg-white text-slate-900 px-8 py-4 rounded-2xl font-black hover:bg-blue-400 hover:text-white transition-all shadow-xl uppercase tracking-wider">
                    Explorar ahora
                </button>
            </div>
            <div class="absolute right-0 top-0 w-1/2 h-full bg-gradient-to-l from-blue-600/20 to-transparent"></div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 pb-24">
        <div class="flex justify-between items-end mb-10">
            <div>
                <h2 class="text-3xl font-black">Catálogo de Estrenos</h2>
                <p class="text-slate-500 mt-2">Seleccionados especialmente para ti.</p>
            </div>
            <div class="flex gap-2">
                <button class="p-3 border rounded-xl hover:bg-white transition-colors"><i data-lucide="sliders-horizontal"></i></button>
            </div>
        </div>

        <div id="contenedorZapatos" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="animate-pulse flex flex-col gap-4">
                <div class="bg-slate-200 h-80 rounded-3xl"></div>
                <div class="bg-slate-200 h-6 w-3/4 rounded-md"></div>
                <div class="bg-slate-200 h-6 w-1/4 rounded-md"></div>
            </div>
            </div>
    </main>

    <footer class="bg-white border-t border-slate-100 py-12">
        <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-8">
            <p class="text-slate-400 text-sm">© 2026 ZapaShop by Enrique. Todos los derechos reservados.</p>
            
            <a href="/admin" class="text-slate-300 hover:text-slate-900 transition-colors">
                <i data-lucide="shield-check" class="w-5 h-5"></i>
            </a>
        </div>
    </footer>

    <script src="/app.js"></script>
    <script>
        // Inicializar iconos de Lucide
        lucide.createIcons();

        // Pequeña lógica para mostrar el nombre si hay sesión
        const user = localStorage.getItem('usuario_logueado');
        if(user) {
            document.getElementById('navUsuario').innerText = `Hola, ${user}`;
        }
    </script>
</body>
</html>
