<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catálogo Completo - ZapaShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen">

    <!-- Barra de Navegación Responsiva con Menú Hamburguesa Integrado -->
    <nav class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50 text-slate-100">
        <div class="max-w-7xl mx-auto px-4 h-20 flex justify-between items-center">
            <a href="/" class="text-xl md:text-2xl font-black text-blue-500 tracking-tight flex items-center gap-2">
                <div class="bg-blue-600 p-2 rounded-xl text-white">
                    <i data-lucide="shopping-bag" class="w-5 h-5"></i>
                </div>
                <span>ZapaShop</span>
            </a>

            <!-- Enlaces de Escritorio -->
            <div class="hidden md:flex gap-8 font-bold text-sm text-slate-300">
                <a href="/" class="hover:text-blue-400 transition-colors">Inicio</a>
                <a href="/catalogo" class="text-blue-400 border-b-2 border-blue-400">Catálogo</a>
                <a href="/carrito" class="hover:text-blue-400 transition-colors">Carrito</a>
            </div>

            <!-- Acciones Derecha -->
            <div class="flex items-center gap-3">
                <a href="/carrito" class="relative group p-2 text-slate-300 hover:text-white">
                    <i data-lucide="shopping-cart" class="w-6 h-6"></i>
                    <span id="cart-count" class="cart-count absolute -top-1 -right-1 bg-blue-600 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">0</span>
                </a>
                <button id="btnHamburguesa" class="md:hidden p-2 text-slate-300 hover:text-white focus:outline-none cursor-pointer">
                    <i data-lucide="menu" class="w-7 h-7"></i>
                </button>
            </div>
        </div>

        <!-- Menú Desplegable Móvil -->
        <div id="menuMovilDesplegable" class="hidden md:hidden bg-slate-950 border-t border-slate-800 px-6 py-5 space-y-4 font-bold text-sm text-slate-300 shadow-2xl">
            <a href="/" class="block hover:text-blue-400 py-1 border-b border-slate-900">🏠 Inicio</a>
            <a href="/catalogo" class="block text-blue-400 py-1 border-b border-slate-900">👟 Catálogo</a>
            <a href="/carrito" class="block hover:text-blue-400 py-1 border-b border-slate-900">🛒 Mi Carrito</a>
            <a href="/perfil" class="block hover:text-blue-400 py-1">👤 Mi Perfil / Cuenta</a>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto py-8 md:py-12 px-4">
        <div class="flex flex-col lg:flex-row justify-between mb-8 md:mb-12 items-start lg:items-center gap-6">
            <div>
                <h1 class="text-3xl md:text-5xl font-black tracking-tighter text-white">Nuestra Colección</h1>
                <p class="text-slate-400 font-medium mt-2 text-sm md:text-base">Explora lo último en tendencia sneakerhead</p>
            </div>

            <div class="flex flex-col sm:flex-row w-full lg:w-auto gap-3">
                <div class="relative flex-grow">
                    <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                    <input type="text" id="searchInput" oninput="cargarZapatos()" placeholder="Buscar modelo..."
                           class="w-full pl-11 pr-4 py-3.5 bg-slate-900 border border-slate-800 rounded-2xl outline-none focus:ring-2 focus:ring-blue-500 transition-all text-sm font-medium text-white shadow-sm placeholder:text-slate-500">
                </div>
                <select id="filtroCategoria" onchange="cargarZapatos()"
                        class="bg-slate-900 border border-slate-800 p-3.5 rounded-2xl font-bold text-sm text-slate-300 outline-none focus:ring-2 focus:ring-blue-500 shadow-sm cursor-pointer">
                    <option value="Todos">Todas las categorías</option>
                    <option value="Sneakers">Sneakers</option>
                    <option value="Botas">Botas</option>
                    <option value="Deportivos">Deportivos</option>
                    <option value="Formal">Formal</option>
                </select>
            </div>
        </div>

        <div id="productsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-10">
            <!-- Los zapatos se cargan dinámicamente aquí -->
        </div>
    </main>

    <script src="/app.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof cargarZapatos === 'function') cargarZapatos();
            if (window.lucide) lucide.createIcons();
        });
    </script>
</body>
</html>
