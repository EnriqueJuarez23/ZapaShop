<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Catálogo Completo - ZapaShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gray-50">
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 h-16 flex justify-between items-center">
            <a href="/" class="text-2xl font-bold text-blue-600">ZapaShop</a>
            <nav class="flex gap-6">
                <a href="/">Inicio</a>
                <a href="/catalogo" class="font-bold text-blue-600">Catálogo</a>
                <a href="/carrito">Carrito</a>
                <a href="/admin">Admin</a>
            </nav>
        </div>
    </header>

    <main class="max-w-7xl mx-auto py-12 px-4">
        <div class="flex flex-col md:flex-row justify-between mb-10 items-center gap-4">
            <h1 class="text-4xl font-black">Nuestra Colección</h1>
            
            <div class="flex gap-4">
                <input type="text" id="searchInput" placeholder="Buscar..." class="p-3 border rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
                <select id="categoryFilter" class="p-3 border rounded-xl outline-none">
                    <option value="Todos">Todos</option>
                    <option value="Sneakers">Sneakers</option>
                    <option value="Botas">Botas</option>
                    <option value="Deportivos">Deportivos</option>
                    <option value="Formal">Formal</option>
                </select>
            </div>
        </div>

        <div id="productsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
            </div>
    </main>

    <script src="/app.js"></script>
    <script>lucide.createIcons();</script>
</body>
</html>
