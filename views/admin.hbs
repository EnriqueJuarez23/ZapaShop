<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel de Control - ZapaShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gray-100 font-sans">
    <div class="min-h-screen flex flex-col items-center justify-center p-6">
        <div class="bg-white w-full max-w-md p-8 rounded-3xl shadow-xl border border-gray-200">
            <div class="flex items-center gap-3 mb-6">
                <div class="p-3 bg-blue-100 rounded-2xl">
                    <i data-lucide="layout-dashboard" class="text-blue-600"></i>
                </div>
                <h1 class="text-2xl font-black text-gray-800">Panel Admin</h1>
            </div>

            <form id="formAdmin" class="space-y-4">
                <input type="text" id="adminNombre" placeholder="Nombre del modelo" required class="w-full p-4 bg-gray-50 border rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
                <input type="number" id="adminPrecio" placeholder="Precio ($)" required class="w-full p-4 bg-gray-50 border rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
                <input type="text" id="adminImg" placeholder="Link de la imagen (URL)" required class="w-full p-4 bg-gray-50 border rounded-xl outline-none focus:ring-2 focus:ring-blue-500">
                
                <button type="submit" class="w-full bg-blue-600 text-white py-4 rounded-xl font-bold hover:bg-blue-700 transition-all shadow-lg">
                    SUBIR AL CATÁLOGO
                </button>
            </form>
            
            <a href="/" class="block text-center mt-6 text-gray-400 hover:text-gray-600 text-sm font-medium transition-colors">
                ← Volver a la tienda
            </a>
        </div>
    </div>
    <script src="/app.js"></script>
    <script>lucide.createIcons();</script>
</body>
</html>
